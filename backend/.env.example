# PromisePocket Backend Environment Configuration

# Server & Security
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
SECRET_KEY=replace_with_a_secure_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# 1. Gemma Open-Weight AI (Ollama Local or Remote Compatible Endpoint)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma:2b
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

# 2. MongoDB Atlas (Persistent Document Memory)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=promisepocket
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# 3. ElevenLabs Voice (Speech-to-Text & Text-to-Speech)
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL_ID=scribe_v1
ELEVENLABS_TTS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TIMEOUT_SECONDS=60

# 4. Temporal Durable Workflows (Durable Timers & Reminders)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=promisepocket-reminders
TEMPORAL_TLS_ENABLED=false
