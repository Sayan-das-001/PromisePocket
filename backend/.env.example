# PromisePocket Backend Environment Configuration (100% Free Setup)

# Server & Security
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0
SECRET_KEY=replace_with_a_secure_random_secret_32_characters_minimum
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=*

# 1. Gemma Open-Weight AI Options (100% Free)
# Option A: Built-in deterministic extraction engine (Default, $0, 0 MB extra RAM)
AI_PROVIDER=demo

# Option B: Free cloud Gemma 2 9B-IT on Groq (Get free key at https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=gemma2-9b-it

# Option C: Local Ollama on your own machine (ollama serve)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma:2b
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

# 2. MongoDB Atlas (Free M0 Shared Cluster)
# Format: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?appName=Cluster0
MONGODB_URI=
MONGODB_DATABASE=promisepocket
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# 3. ElevenLabs Voice (Optional - Free Tier or Browser Web Speech fallback)
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL_ID=scribe_v1
ELEVENLABS_TTS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TIMEOUT_SECONDS=60

# 4. Temporal Durable Workflows (Optional - Development fallback runs in-process)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=promisepocket-reminders
TEMPORAL_TLS_ENABLED=false
